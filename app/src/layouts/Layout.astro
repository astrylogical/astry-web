---
import '../styles/global.css';
import faviconSvg from '../assets/brand/astry-mark.svg?url';
import faviconPng from '../assets/brand/astry-mark.png?url';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Astry',
	description = 'Astrology for your everyday.'
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={faviconPng} />
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
